generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum SmtpEncryption {
  NONE
  STARTTLS
  SSL
}

enum EmailSendType {
  AUTOMATIC
  MANUAL
  RESEND_AFTER_CHANGE
}

enum EmailSendStatus {
  SUCCESS
  ERROR
}

enum AccountTokenType {
  ACTIVATION
  RESET
}

model User {
  id           String   @id @default(cuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  proPhone     String?  @map("pro_phone")
  privatePhone String?  @map("private_phone")
  email        String   @unique
  locale       String   @default("fr")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships        UserGroup[]
  permanences        Permanence[]  @relation("PermanenceAssignee")
  account            Account?

  @@index([lastName, firstName])
  @@map("users")
}

model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     UserGroup[]
  permanences Permanence[]

  @@map("groups")
}

model UserGroup {
  userId    String   @map("user_id")
  groupId   String   @map("group_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("user_groups")
}

model Permanence {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  weekYear  Int      @map("week_year")
  weekNumber Int     @map("week_number")
  userId    String   @map("user_id")
  groupId   String   @map("group_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String? @map("created_by")
  updatedById String? @map("updated_by")

  user      User     @relation("PermanenceAssignee", fields: [userId], references: [id], onDelete: Restrict)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy Account? @relation("PermanenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Account? @relation("PermanenceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([date, groupId])
  @@index([date])
  @@index([userId])
  @@index([weekYear, weekNumber])
  @@map("permanences")
}

model Account {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  role         Role      @default(USER)
  active       Boolean   @default(true)
  userId       String?   @unique @map("user_id")
  activatedAt  DateTime? @map("activated_at")
  lastLoginAt  DateTime? @map("last_login_at")
  locale       String    @default("fr")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions           Session[]
  tokens             AccountToken[]
  createdPermanences Permanence[]   @relation("PermanenceCreatedBy")
  updatedPermanences Permanence[]   @relation("PermanenceUpdatedBy")
  emailSends         EmailHistory[] @relation("EmailSentBy")

  @@map("accounts")
}

model AccountToken {
  id        String           @id @default(cuid())
  accountId String           @map("account_id")
  type      AccountTokenType
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("account_tokens")
}


model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  accountId String   @map("account_id")
  expiresAt DateTime @map("expires_at")
  userAgent String?  @map("user_agent")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("sessions")
}

model EmailConfiguration {
  id                    String         @id @default("default")
  smtpHost              String         @map("smtp_host")
  smtpPort              Int            @map("smtp_port")
  smtpEncryption        SmtpEncryption @default(STARTTLS) @map("smtp_encryption")
  smtpUser              String?        @map("smtp_user")
  smtpPasswordEncrypted String?        @map("smtp_password_encrypted")
  fromAddress           String         @map("from_address")
  fromName              String?        @map("from_name")
  replyTo               String?        @map("reply_to")
  ccRecipients          String[]       @default([]) @map("cc_recipients")
  sendDayOfWeek         Int            @default(3) @map("send_day_of_week")
  sendTime              String         @default("09:00") @map("send_time")
  timezone              String         @default("Europe/Paris")
  enabled               Boolean        @default(false)
  introHtml             String?        @map("intro_html")
  outroHtml             String?        @map("outro_html")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@map("email_configuration")
}

model AppConfiguration {
  id        String   @id @default("default")
  appUrl    String?  @map("app_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_configuration")
}

model PlanningVersion {
  id          String   @id @default(cuid())
  weekYear    Int      @map("week_year")
  weekNumber  Int      @map("week_number")
  weekStart   DateTime @db.Date @map("week_start")
  weekEnd     DateTime @db.Date @map("week_end")
  snapshot    Json
  contentHash String   @map("content_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  emailSends EmailHistory[]

  @@index([weekYear, weekNumber])
  @@map("planning_versions")
}

model EmailHistory {
  id                String          @id @default(cuid())
  weekYear          Int             @map("week_year")
  weekNumber        Int             @map("week_number")
  weekStart         DateTime        @db.Date @map("week_start")
  weekEnd           DateTime        @db.Date @map("week_end")
  sentAt            DateTime        @default(now()) @map("sent_at")
  type              EmailSendType   @default(MANUAL)
  recipients        String[]        @default([])
  ccRecipients      String[]        @default([]) @map("cc_recipients")
  status            EmailSendStatus @default(SUCCESS)
  error             String?
  contentHash       String?         @map("content_hash")
  planningVersionId String?         @map("planning_version_id")
  sentByAccountId   String?         @map("sent_by_account_id")

  planningVersion PlanningVersion? @relation(fields: [planningVersionId], references: [id], onDelete: SetNull)
  sentBy          Account?         @relation("EmailSentBy", fields: [sentByAccountId], references: [id], onDelete: SetNull)

  @@index([weekYear, weekNumber])
  @@map("email_history")
}
