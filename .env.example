# =============================================================================
# Permanence - variables d'environnement
# Copier ce fichier vers .env puis adapter les valeurs.
# =============================================================================

# Connexion PostgreSQL (obligatoire). En docker compose, l'hote est "db".
DATABASE_URL="postgresql://permanence:permanence@localhost:5432/permanence?schema=public"

# Secret applicatif (obligatoire). Sert a signer les sessions et chiffrer le
# mot de passe SMTP. Utiliser une chaine aleatoire de 32 caracteres minimum.
# Generation : openssl rand -hex 32
APP_SECRET="change-me-with-a-long-random-value"

# Fuseau horaire utilise par le planificateur d'envoi des emails.
TIMEZONE="Europe/Paris"

# Cle de chiffrement des Server Actions Next.js. Doit rester stable entre les
# redemarrages et identique sur toutes les instances.
# Generation : openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="change-me-stable-key"

# Compte administrateur cree au premier demarrage (seed).
# ADMIN_SYNC_PASSWORD=true (defaut) : si le mot de passe enregistre ne
# correspond plus a ADMIN_PASSWORD, il est re-aligne au demarrage. Mettre
# "false" pour ne plus jamais modifier le mot de passe depuis ce fichier.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# ADMIN_SYNC_PASSWORD="true"

# Niveau de log (info par defaut).
LOG_LEVEL="info"

# --- Docker Compose : base de donnees et port HTTP expose ---
# POSTGRES_USER="permanence"
# POSTGRES_PASSWORD="change-me"
# POSTGRES_DB="permanence"
# APP_PORT="3000"

# --- SMTP ---
# La configuration SMTP (serveur, port, chiffrement, identifiants, expediteur,
# CC, jour et heure d'envoi) se fait uniquement dans l'interface, menu
# "Emails". Aucune variable d'environnement SMTP n'est necessaire.
